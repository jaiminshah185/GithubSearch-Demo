@model StoredRecordsResponse
@{
    int displayStart = Model.TotalCount > 0 ? (Model.CurrentPage - 1) * Model.PageSize + 1 : 0;
    int displayEnd = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
}
<div class="container mt-4">
    <h2>Stored Records</h2>

    <form method="get" asp-action="GetStoredResult" class="form-inline mb-3">
        <div class="input-group">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, node ID, username" />
            <input type="hidden" name="sortBy" value="@Model.SortBy" />
            <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="GetStoredResult" class="btn btn-secondary">Clear</a>
        </div>
    </form>

@if (Model.TotalCount > 0)
{
        <p>Displaying records @displayStart - @displayEnd of @Model.TotalCount</p>
        <table class="table table-bordered" id="tblSavedRecords">
            <thead>
                <tr>
                    <th>
                        <a href="@Url.Action("GetStoredResult", new { search = Model.Search, sortBy = "Username", sortOrder = Model.SortBy == "Username" && Model.SortOrder == "asc" ? "desc" : "asc", page = 1 })">Username</a>
                    </th>
                    <th>
                        <a href="@Url.Action("GetStoredResult", new { search = Model.Search, sortBy = "Name", sortOrder = Model.SortBy == "Name" && Model.SortOrder == "asc" ? "desc" : "asc", page = 1 })">Repository Name</a>
                    </th>
                    <th>
                        <a href="@Url.Action("GetStoredResult", new { search = Model.Search, sortBy = "NodeId", sortOrder = Model.SortBy == "NodeId" && Model.SortOrder == "asc" ? "desc" : "asc", page = 1 })">Node ID</a>
                    </th>
                    <th>
                        <a href="@Url.Action("GetStoredResult", new { search = Model.Search, sortBy = "StargazersCount", sortOrder = (string.IsNullOrEmpty(Model.SortBy) || Model.SortBy == "StargazersCount") && Model.SortOrder != "asc" ? "asc" : "desc", page = 1 })">Stargazers Count</a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Items)
                {
                    <tr>
                        <td>@record.Username</td>
                        <td>@record.Name</td>
                        <td>@record.NodeId</td>
                        <td>@record.StargazersCount</td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Pagination controls -->
    @if (Model.TotalPages > 1)
    {
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <li class="page-item active"><span class="page-link">@i</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action("GetStoredResult", new { page = i, search = Model.Search, sortBy = Model.SortBy, sortOrder = Model.SortOrder })">@i</a></li>
                        }
                    }
                </ul>
            </nav>
    }
}
else
{
        <p>No stored records found.</p>
}
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs5/3.1.3/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tblSavedRecords').DataTable({
                paging: false,
                searching: false,
                info: false,
                ordering: false
            });
        });
    </script>
</div>
